{
  "name": "stormgtm-mcp",
  "version": "0.5.1",
  "description": "StormGTM MCP server — qualify leads with Barometer and send through your own domains, over stdio",
  "license": "MIT",
  "type": "module",
  "author": "Margin Systems <hello@stormgtm.com>",
  "keywords": [
    "stormgtm",
    "mcp",
    "email",
    "deliverability",
    "lead-qualification"
  ],
  "bin": {
    "stormgtm-mcp": "dist/index.js"
  },
  "homepage": "https://github.com/marginsystems/stormgtm-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marginsystems/stormgtm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/marginsystems/stormgtm-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "stormgtm": "0.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
